{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Script Workbench",
  "version": "0.1.0",
  "identifier": "com.lmoon.scriptworkbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Script Workbench",
        "width": 1560,
        "height": 980,
        "minWidth": 1220,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$PICTURE/**",
          "$TEMP/**",
          "$APPDATA/**",
          "$HOME/**",
          "*:\\**\\*.png"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/python/**/*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
